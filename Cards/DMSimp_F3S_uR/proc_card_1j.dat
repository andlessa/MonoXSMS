set group_subprocesses Auto
set ignore_six_quark_processes False
set low_mem_multicore_nlo_generation False
set complex_mass_scheme False
set include_lepton_initiated_processes False
set gauge unitary
set loop_optimized_output True
set loop_color_flows False
set max_npoint_for_channel 0
set default_unset_couplings 99
set max_t_for_channel 99
set zerowidth_tchannel True
set nlo_mixed_expansion True
import model sm
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
import model /home/camila/MonoXSMS/modelFiles/DMSimp_t-F3S_uR --modelname
define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
define j = p
define dm = xs
generate p p > dm dm j $$ yf3u1 yf3u1~ / yf3qu1 yf3qu2 yf3qu3 yf3qd1 yf3qd2 yf3qd3 yf3u2 yf3u3 yf3d1 yf3d2 yf3d3 ys3qu1 ys3qu2 ys3qu3 ys3qd1 ys3qd2 ys3qd3 ys3u2 ys3u3 ys3d1 ys3d2 ys3d3 xs xm xv
output DMSimpt_F3S_uR
